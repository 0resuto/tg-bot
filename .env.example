# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file with real secrets.
# ==============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
ADMIN_CHAT_ID=
GROUP_CHAT_ID=

# --- Bot Persona ---
# Comma-separated names the bot responds to (Latin and/or Cyrillic).
# Transliterated variants are generated automatically.
BOT_NAMES=Bot
BOT_LANGUAGE=ru
# Short inline system prompt for the bot persona (Russian text is OK here):
BOT_PERSONA_SYSTEM_PROMPT=
# Path to a .txt file with a longer persona prompt (takes precedence over inline):
BOT_PERSONA_PROMPT_FILE=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4o
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tgbot
POSTGRES_USER=tgbot
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memory & Behavior ---
DEBOUNCE_SECONDS=10
CONTEXT_WINDOW_MINUTES=15
CONTEXT_MIN_MESSAGES=10
PROACTIVE_REPLIES_ENABLED=false
MEMORY_SEARCH_LIMIT_QUICK=5
MEMORY_SEARCH_LIMIT_DEEP=15
MEMORY_USER_SUMMARY_CACHE_TTL=300

# --- Sensitive Topic Filter ---
SENSITIVE_FILTER_ENABLED=true
# Comma-separated categories: health,finance,credentials,legal,sexual,political
SENSITIVE_CATEGORIES=health,finance,credentials,legal,sexual,political

# --- Web Dashboard & Control Panel ---
# Secret key to authenticate REST API endpoints (/api/*).
# If left empty, API access is only permitted from loopback (127.0.0.1 / localhost).
# Set a secure random string when deploying or exposing port 8080.
WEB_API_KEY=
WEB_HOST=127.0.0.1
WEB_PORT=8080


# --- Dev Only (Optional, for docker-compose.override.yml.example) ---
# If you enable the dev override to access DBs from host, you can customize ports here
# to avoid conflicts with existing services:
DEV_POSTGRES_PORT=15432
DEV_REDIS_PORT=16379
DEV_NEO4J_HTTP_PORT=17474
DEV_NEO4J_BOLT_PORT=17687
