# Dev-only port mappings.
# Copy this file to `docker-compose.override.yml` ONLY if you need direct
# access to database ports from your host machine (e.g. for DBeaver or Redis Insight).
#
# Ports default to high/non-conflicting values (16379, 15432, 17474, 17687)
# so they never collide with already running services on your machine.

services:
  postgres:
    ports:
      - "127.0.0.1:${DEV_POSTGRES_PORT:-15432}:5432"

  redis:
    ports:
      - "127.0.0.1:${DEV_REDIS_PORT:-16379}:6379"

  neo4j:
    ports:
      - "127.0.0.1:${DEV_NEO4J_HTTP_PORT:-17474}:7474"
      - "127.0.0.1:${DEV_NEO4J_BOLT_PORT:-17687}:7687"
